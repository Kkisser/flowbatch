# ШАБЛОН. Скопируй в .env и заполняй ТАМ.
#
# Этот файл (.env.example) отслеживается git и уезжает в публичный репозиторий —
# реальные ключи сюда вписывать нельзя. Файл .env, наоборот, в .gitignore и
# наружу не попадает. Проверка: python -m flowbatch.cli doctor скажет, если
# ключ окажется не в том файле.

# --- Telegram-уведомления (опционально) ---
# Токен бота от @BotFather (вида 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Твой chat_id. Узнать: напиши боту @userinfobot, он пришлёт числовой id.
TELEGRAM_CHAT_ID=

# --- Смягчение промптов при отказе модерации (README, раздел 9a) ---
#
# Gemini — рекомендую. Ключ берётся на https://aistudio.google.com/apikey
# ВАЖНО: подписка Google AI Pro/Ultra (та, что даёт Flow и Gemini Advanced)
# сама по себе ключа НЕ даёт — по документации Google планы для AI Studio
# отделены от тарифов Gemini API. Подписка поднимает лимиты внутри веб-студии
# AI Studio, а для API нужен ключ с её же страницы; бесплатного тарифа ключа
# для смягчения промптов хватает с большим запасом.
# Проверить ключ, не запуская браузер:  python -m flowbatch.cli soften-test
GEMINI_API_KEY=
# Claude (платный, опционально; нужен pip install anthropic).
ANTHROPIC_API_KEY=
