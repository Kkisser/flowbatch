.env
out/
runs.jsonl
screenshots/
# Перенаправленный вывод процессов: туда попадают трассировки Playwright,
# а в них — заголовок Cookie с session-token.
*.out
*.err
*.log
# Локальный кэш uuid референсов, текст из панели и её настройки
.flowbatch_refcache.json
.flowbatch_ui.json
prompts_pasted.flow.txt
# Фото продуктов — бинарные бренд-активы, в репозиторий не идут.
# Структура папок и README остаются (.gitkeep не подпадает под маски медиа).
products/**/*.jpg
products/**/*.jpeg
products/**/*.png
products/**/*.webp
*.png
*.jpg
*.mp4
.venv/
__pycache__/
*.pyc
