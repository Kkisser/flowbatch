.env
out/
runs.jsonl
screenshots/
# Перенаправленный вывод процессов: туда попадают трассировки Playwright,
# а в них — заголовок Cookie с session-token.
*.out
*.err
*.log
# Локальный кэш uuid референсов, текст из панели и её настройки
.flowbatch_refcache.json
.flowbatch_ui.json
# Черновики из панели: перезаписываются при каждой вставке текста.
# Именованные очереди в prompts/ отслеживаются — это рабочий материал.
prompts/pasted_*.flow.txt
# Старые имена, до переезда в prompts/
prompts_pasted.flow.txt
prompts_pasted_*.flow.txt
# Фото продуктов — бинарные бренд-активы, в репозиторий не идут.
# Структура папок и README остаются (.gitkeep не подпадает под маски медиа).
products/**/*.jpg
products/**/*.jpeg
products/**/*.png
products/**/*.webp
*.png
*.jpg
*.mp4
.venv/
__pycache__/
*.pyc

# Мусорный профиль от старого бага с нераскрытой ~ (см. browser.py)
~/
